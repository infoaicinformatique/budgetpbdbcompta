{
  "name": "excel-grid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "check": "node scripts/check-imports.js",
    "check:app": "node --experimental-strip-types scripts/check-budget-app.mjs",
    "check:markup": "node scripts/check-tab-markup.mjs",
    "profile": "node --expose-gc scripts/profile-app.mjs",
    "profile:memory": "node --expose-gc scripts/profile-memory.mjs",
    "import:pcg": "node scripts/import-pcg.mjs",
    "import:budget": "node --experimental-strip-types scripts/import-budget.mjs",
    "verify": "npm run check && npm run test && npm run check:app && npm run check:markup && npm run typecheck"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.12"
  }
}
