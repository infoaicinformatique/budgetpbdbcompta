# Déploiement automatique : exécuté par budgetpbdbcompta-deploy.timer.
#   cp deploy/budgetpbdbcompta-deploy.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now budgetpbdbcompta-deploy.timer
[Unit]
Description=Déploiement automatique de budgetpbdbcompta depuis GitHub (main)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=DEPLOY_DIR=/opt/docker/budgetpbdbcompta
Environment=DEPLOY_BRANCH=main
ExecStart=/opt/docker/budgetpbdbcompta/deploy/auto-deploy.sh
TimeoutStartSec=15min
