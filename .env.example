# Docker : copier en .env à côté de docker-compose.yml
# systemd : copier en /etc/budgetpbdbcompta.env (deploy/budgetpbdbcompta.service)
# Docker : HOST est forcé à 0.0.0.0 par docker-compose.yml.
# systemd : 0.0.0.0 si Nginx Proxy Manager est sur une autre machine.
HOST=127.0.0.1
PORT=3000
PUBLIC_HOST=budgetpbdbcompta.aic-informatique.net
# Décommenter pour protéger l'accès par identifiant / mot de passe.
# Avec LDAP, ce compte local reste valable : c'est l'accès de secours si
# l'annuaire est en panne.
#BASIC_AUTH_USER=alexis
#BASIC_AUTH_PASSWORD=changez-moi

# ---- Authentification par annuaire LDAP (Active Directory, OpenLDAP…) ----
# Désactivée tant que LDAP_URL est vide. Plusieurs URL = bascule si la
# première est injoignable. ldaps:// (636) ou LDAP_STARTTLS=true recommandés :
# en ldap:// simple, les mots de passe circulent en clair sur le réseau.
#LDAP_URL=ldaps://dc1.exemple.local:636, ldaps://dc2.exemple.local:636
#
# Façon de trouver l'utilisateur : UNE des deux options.
#  a) bind direct, avec un modèle ({username} = identifiant saisi) :
#LDAP_USER_DN={username}@exemple.local
#LDAP_USER_DN=uid={username},ou=people,dc=exemple,dc=fr
#  b) recherche puis bind (nécessaire pour LDAP_GROUP_DN) :
#LDAP_SEARCH_BASE=ou=Utilisateurs,dc=exemple,dc=local
#LDAP_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={username}))
#LDAP_BIND_DN=CN=svc-budget,OU=Services,DC=exemple,DC=local
#LDAP_BIND_PASSWORD=mot-de-passe-du-compte-de-service
#
# Facultatif : réserver l'accès aux membres d'un groupe (member, uniqueMember
# ou memberUid ; les groupes imbriqués d'AD ne sont pas suivis).
#LDAP_GROUP_DN=CN=Budget,OU=Groupes,DC=exemple,DC=local
#
#LDAP_STARTTLS=false
# Autorité de certification interne (chemin DANS le conteneur, voir
# docker-compose.yml) ; false n'est acceptable que pour un essai.
#LDAP_CA_FILE=/certs/ldap-ca.pem
#LDAP_TLS_REJECT_UNAUTHORIZED=true
#LDAP_TIMEOUT_MS=5000
# Durée (s) pendant laquelle une connexion réussie est mémorisée.
#LDAP_CACHE_SECONDS=300

# ---- Droits dans l'application (Paramètres › Droits d'accès) ----
# Avec LDAP, les droits de chacun (rôle, onglets, sociétés…) sont tenus par
# le serveur et réglés par un administrateur dans Paramètres. Une personne
# sans droits n'a accès qu'à Paramètres. Identifiants (sAMAccountName) qui
# restent toujours administrateurs — au moins un, pour le premier réglage :
#RIGHTS_ADMINS=prenom.nom
# Emplacement du fichier (Docker : /data/droits.json, volume « droits »).
#RIGHTS_FILE=./data/droits.json
